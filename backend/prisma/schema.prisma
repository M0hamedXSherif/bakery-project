datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id       Int      @id @default(autoincrement())
  name     String
  sellType String   @default("unit")
  price    Float
  stock    Float
  imageUrl String?
  alt      String?
}

model Ingredient {
  id    Int    @id @default(autoincrement())
  name  String
  unit  String
  stock Float
}

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String
  role       String  @default("staff")
  isApproved Boolean @default(false)
}
